{
  "projectId": "0ff517bb-9442-4157-87ca-0d8166163b81",
  "shape": "package",
  "pkg": "drosia",
  "globalName": "Drosia",
  "tsconfig": ".design-sync/tsconfig.design.json",
  "readmeHeader": ".design-sync/conventions.md",
  "entry": ".design-sync/ds-entry.ts",
  "srcDir": "components",
  "buildCmd": "npx tailwindcss -c tailwind.config.ts -i app/globals.css -o .design-sync/.cache/tailwind.css && cat .design-sync/tokens/font-vars.css >> .design-sync/.cache/tailwind.css",
  "cssEntry": ".design-sync/.cache/tailwind.css",
  "extraFonts": [".design-sync/fonts/drosia-fonts.css"],
  "docsMap": {
    "Button": ".design-sync/docs/Button.md",
    "ButtonLink": ".design-sync/docs/ButtonLink.md",
    "AppBar": ".design-sync/docs/AppBar.md",
    "BottomNav": ".design-sync/docs/BottomNav.md",
    "CategoryIcon": ".design-sync/docs/CategoryIcon.md",
    "LangSwitch": ".design-sync/docs/LangSwitch.md",
    "PhotoPlaceholder": ".design-sync/docs/PhotoPlaceholder.md",
    "SeverityPill": ".design-sync/docs/SeverityPill.md",
    "SeverityCounter": ".design-sync/docs/SeverityCounter.md",
    "StatusTimeline": ".design-sync/docs/StatusTimeline.md",
    "ThemeToggle": ".design-sync/docs/ThemeToggle.md",
    "VoteBar": ".design-sync/docs/VoteBar.md"
  },
  "provider": { "component": "LocaleProvider", "props": { "initialLocale": "en" } },
  "overrides": {
    "AppBar": { "cardMode": "column" },
    "CategoryIcon": { "cardMode": "column" },
    "StatusTimeline": { "cardMode": "column" },
    "VoteBar": { "cardMode": "column" }
  },
  "componentSrcMap": {
    "Button": "components/ui/Button.tsx",
    "ButtonLink": "components/ui/Button.tsx",
    "AppBar": "components/ui/AppBar.tsx",
    "BottomNav": "components/ui/BottomNav.tsx",
    "CategoryIcon": "components/ui/CategoryIcon.tsx",
    "LangSwitch": "components/ui/LangSwitch.tsx",
    "PhotoPlaceholder": "components/ui/Photo.tsx",
    "SeverityPill": "components/ui/Severity.tsx",
    "SeverityCounter": "components/ui/Severity.tsx",
    "StatusTimeline": "components/ui/StatusTimeline.tsx",
    "ThemeToggle": "components/ui/ThemeToggle.tsx",
    "VoteBar": "components/ui/VoteBar.tsx",
    "DrosiaMark": "components/brand/Logo.tsx",
    "DrosiaWordmark": "components/brand/Logo.tsx",
    "LocaleProvider": null,
    "TrackPageView": null,
    "DrosiaMap": null,
    "AdminBoard": null,
    "ImpactScreen": null,
    "LandingScreen": null,
    "LegalScreen": null,
    "ListScreen": null,
    "MapScreen": null,
    "NotFoundScreen": null,
    "ReportFlow": null,
    "ScorecardScreen": null,
    "ShareCard": null,
    "SupportContactForm": null,
    "SupportScreen": null,
    "TrackingScreen": null
  }
}
